// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  STUDENT
  ADMIN
  TEACHER_ADMINISTRATIVE
}

enum VehicleType {
  CAR
  MOTORCYCLE
}

enum DocumentType {
  CC
  TI
  CE
}

enum ProfileRole {
  DRIVER
  PASSENGER
  COMPANION
}

enum LicenseValidation {
  PENDING
  VERIFIED
  REJECTED
}

model Users {
  id              String     @id @default(uuid())
  name            String
  email           String     @unique
  role            UserType?
  profile         Profiles?
  vehicles        Vehicles[]
  ratingsGiven    Ratings[]  @relation("RatingsGiven")
  ratingsReceived Ratings[]  @relation("RatingsReceived")
}

model Vehicles {
  id            String  @id @default(uuid())
  brand         String
  model         String
  plate         String  @unique
  type          VehicleType
  insurance  String?
  userId     String
  user          Users  @relation(fields: [userId], references: [id])
}

model Profiles {
  id                String             @id @default(uuid())
  documentType      DocumentType
  documentNumber    String             @unique
  phone             String             @unique
  studentId         String?            @unique
  role              ProfileRole?
  rate              Float              @default(0)
  lastSession       DateTime           @default(now())
  userId            String             @unique
  user              Users              @relation(fields: [userId], references: [id])
  photo             String?
  driverLicense     String?
  licenseValidation LicenseValidation  @default(PENDING)
  verifiedAt        DateTime?
  rejectionReason   String?
}

model Ratings {
  id          String      @id @default(uuid())
  tripId      String
  raterId     String
  ratedUserId String
  role        ProfileRole
  stars       Int
  comment     String?
  createdAt   DateTime    @default(now())

  rater     Users @relation("RatingsGiven", fields: [raterId], references: [id])
  ratedUser Users @relation("RatingsReceived", fields: [ratedUserId], references: [id])

  @@unique([tripId, raterId])
}
